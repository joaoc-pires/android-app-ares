<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head>
    <title>Reader subscriptions</title>
  </head>
  <body>
    <outline text="News" title="News">
      <outline type="rss" text="Daily News" title="Daily News" xmlUrl="https://news.example/feed" htmlUrl="https://news.example"/>
      <outline type="rss" text="World Report" title="World Report" xmlUrl="https://world.example/rss.xml" htmlUrl="https://world.example"/>
    </outline>
    <outline text="Tech" title="Tech">
      <outline type="rss" text="Gadgets" title="Gadgets" xmlUrl="https://gadgets.example/feed/" htmlUrl="https://gadgets.example"/>
    </outline>
    <outline type="rss" text="Loose Feed" title="Loose Feed" xmlUrl="https://loose.example/feed"/>
  </body>
</opml>
